# TEST FIXTURE (LABS-1.022): a minimal organisation profile for installation and subtype tests. Not the D-2 profile.
define
entity staff-member sub physical-object;
entity company sub social-object;
relation post-holding sub classified-as;                                     # single-holder offices (slot, as data)
relation acting-post-holding sub post-holding;                                # a deeper subtype; inherits the slot
