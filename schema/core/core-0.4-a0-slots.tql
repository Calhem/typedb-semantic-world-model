# Core 0.4, Stage A0.3 (LABS-1.002): functional-slot declarations, stored as data in TypeDB (U-4: implementation
# choice consistent with "TypeDB is the only store"; profile packaging is Stage D).
#
# A declaration (a functional constraint) says: for content of this proposition type and of all its subtypes, at most
# one value of `value-role` holds at a time for each combination of the `slot-role` players. located-at has slot
# (located) and value place; a seat assignment might have slot (venue, seat) and value occupant.
# A type may have several constraints. Subtypes inherit every constraint of their ancestors, and their own
# declarations add constraints; nothing replaces or weakens an inherited one (U-5, LABS-1.003).
# Role names are core role names (a specialised role is named by the core role it specialises).

define
attribute slot-id, value string;                    # predicate|key roles|value role
attribute slot-predicate, value string;
attribute slot-role, value string;
attribute value-role, value string;
entity functional-slot, owns slot-id @key, owns slot-predicate @card(1..1), owns slot-role @card(1..),
  owns value-role @card(1..1);
