{"id": "e2-m-calib-1",
 "description": "Synthetic pump housing housing-h2 (invented). Bore diameter measured by six gauges, one measurement each, at distinct times, to isolate calibration situations: c1 before its certificate starts (not yet effective); c3 with an uncertain activity start window [T9, T13] inside which cert-g3's validity ends at T11; c4 with an accepted system calibration and an accepted denial by qa-dept (disputed); c5 whose only calibration claim is by calibra-house and unreviewed; c6 with no certificate; c7 between an expired certificate (to T15) and a renewal that starts at T17.",
 "profiles": ["organisation", "laboratory"],
 "steps": [
   {"op": "world", "id": "w", "kind": "actual"},
   {"op": "entity", "kind": "physical-object", "id": "housing-h2", "name": "pump housing H2"},
   {"op": "entity", "kind": "physical-object", "id": "gauge-1", "name": "bore gauge 1"},
   {"op": "entity", "kind": "physical-object", "id": "gauge-3", "name": "bore gauge 3"},
   {"op": "entity", "kind": "physical-object", "id": "gauge-4", "name": "bore gauge 4"},
   {"op": "entity", "kind": "physical-object", "id": "gauge-5", "name": "bore gauge 5"},
   {"op": "entity", "kind": "physical-object", "id": "gauge-6", "name": "bore gauge 6"},
   {"op": "entity", "kind": "physical-object", "id": "gauge-7", "name": "bore gauge 7"},
   {"op": "entity", "kind": "organisation", "id": "qa-dept", "name": "quality assurance department"},
   {"op": "entity", "kind": "organisation", "id": "calibra-house", "name": "Calibra calibration house"},
   {"op": "define_unit", "id": "metre", "name": "metre", "dimension": "length", "si_factor": 1, "si_offset": 0},
   {"op": "define_unit", "id": "millimetre", "name": "millimetre", "dimension": "length", "si_factor": 0.001, "si_offset": 0},
   {"op": "define_quality_kind", "id": "bore-diameter", "name": "bore diameter", "dimension": "length"},
   {"op": "certificate", "id": "cert-g1", "name": "gauge 1 certificate", "reference": "G1-2026"},
   {"op": "certificate", "id": "cert-g3", "name": "gauge 3 certificate", "reference": "G3-A"},
   {"op": "certificate", "id": "cert-g4", "name": "gauge 4 certificate", "reference": "G4-B"},
   {"op": "certificate", "id": "cert-g5", "name": "gauge 5 certificate", "reference": "G5-X"},
