   {"op": "certificate", "id": "cert-g7b", "name": "gauge 7 certificate (renewal)", "reference": "G7-2"},
   {"op": "calibrate", "id": "cal-g1", "world": "w", "certificate": "cert-g1", "instrument": "gauge-1", "start": "T10", "end": "T25"},
