   {"op": "calibrate", "id": "cal-g5", "world": "w", "certificate": "cert-g5", "instrument": "gauge-5", "start": "T1", "end": "T30", "attester": "calibra-house"},
   {"op": "calibrate", "id": "cal-g7a", "world": "w", "certificate": "cert-g7a", "instrument": "gauge-7", "start": "T1", "end": "T15"},
   {"op": "calibrate", "id": "cal-g7b", "world": "w", "certificate": "cert-g7b", "instrument": "gauge-7", "start": "T17", "until_superseded": true},
   {"op": "measure", "id": "c1", "world": "w", "bearer": "housing-h2", "quality": "bore-diameter", "value": 80.02, "unit": "millimetre", "uncertainty": 0.005, "k": 2, "start": "T8", "instrument": "gauge-1", "conditions": ["20 C"], "calibration": "G1-2026"},
   {"op": "measure", "id": "c3", "world": "w", "bearer": "housing-h2", "quality": "bore-diameter", "value": 80.01, "unit": "millimetre", "uncertainty": 0.005, "k": 2, "start": ["T9", "T13"], "end": "T14", "instrument": "gauge-3", "conditions": ["20 C"], "calibration": "G3-A"},
   {"op": "measure", "id": "c4", "world": "w", "bearer": "housing-h2", "quality": "bore-diameter", "value": 80.03, "unit": "millimetre", "uncertainty": 0.005, "k": 2, "start": "T20", "instrument": "gauge-4", "conditions": ["20 C"], "calibration": "G4-B"},
