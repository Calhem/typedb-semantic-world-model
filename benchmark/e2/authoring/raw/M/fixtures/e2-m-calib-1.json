   {"op": "measure", "id": "c6", "world": "w", "bearer": "housing-h2", "quality": "bore-diameter", "value": 79.99, "unit": "millimetre", "uncertainty": 0.005, "k": 2, "start": "T7", "instrument": "gauge-6", "conditions": ["20 C"], "calibration": "G6-N"},
   {"op": "measure", "id": "c7", "world": "w", "bearer": "housing-h2", "quality": "bore-diameter", "value": 80.02, "unit": "millimetre", "uncertainty": 0.005, "k": 2, "start": "T16", "instrument": "gauge-7", "conditions": ["20 C"], "calibration": "G7-1"}
 ]}
